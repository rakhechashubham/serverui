# Copy to .env and fill in local values:
#   cp .env.example .env
#   make setup-env
#
# Never commit a real .env file.
# Use fictional values only in docs and examples.

# --- Runtime / ports ---
HTTP_PORT=8080
WEB_PORT=3000

# --- Database ---
POSTGRES_USER=serverui
POSTGRES_PASSWORD=example_password
POSTGRES_DB=serverui
# Native/source default host is 127.0.0.1 (set by the Go server when unset).
# Docker Compose sets POSTGRES_HOST=postgres in deploy/docker/docker-compose.yml.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Optional DSN. Prefer POSTGRES_* with Compose (server service sets POSTGRES_HOST=postgres).
# For a native Go process against local Postgres, use loopback, for example:
# DATABASE_URL=postgresql://serverui:example_password@127.0.0.1:5432/serverui?sslmode=disable
DATABASE_URL=

# --- Credentials (backend only; never expose to the browser) ---
# 32-byte AES-256-GCM key as 64 hex characters.
# Generate with: openssl rand -hex 32
# make setup-env will generate one if this is empty.
SERVERUI_CREDENTIAL_ENCRYPTION_KEY=

# --- Browser API (optional) ---
# Absolute origin for the Go API when the UI should not use same-origin rewrites.
# Web example:  https://api.example.test
# Desktop: injected at runtime by Tauri (do not hardcode a fixed port).
# NEXT_PUBLIC_API_BASE=

# Runtime mode override for experiments. Prefer Tauri injection for real desktop.
# NEXT_PUBLIC_SERVERUI_RUNTIME=web

# --- Desktop local API (set by Tauri at launch; do not commit real values) ---
# SERVERUI_DESKTOP=1
# SERVERUI_LISTEN_HOST=127.0.0.1
# SERVERUI_LOCAL_AUTH_TOKEN=   # per-launch secret generated by the desktop shell
# SERVERUI_BACKEND_BIN=        # optional absolute path to serverui-server
# SERVERUI_ALLOW_NON_LOOPBACK=1  # developer-only; never set by Tauri
# Packaged/default desktop storage (set automatically by Tauri):
# SERVERUI_STORAGE=sqlite
# SERVERUI_DATABASE_PATH=/path/to/app-data/serverui.db
# Optional developer override to force Postgres desktop testing:
# SERVERUI_STORAGE=postgres

# --- Deployment / Next.js rewrites (server-side only; not a browser secret) ---
# Used inside the web container to reach the Go service by Docker DNS name.
# SERVER_INTERNAL_URL=http://server:8080
