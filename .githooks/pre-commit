#!/usr/bin/env bash
# Pre-commit hook: runs format-check, lint, and tests
# Configured via: make hooks  (sets core.hooksPath=.githooks)

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "pre-commit: format-check"
make format-check

echo "pre-commit: lint"
make lint

echo "pre-commit: test"
make test

echo "pre-commit: ok"