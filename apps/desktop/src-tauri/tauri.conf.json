{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerUI",
  "version": "0.1.0",
  "identifier": "com.serverui.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node ./scripts/prepare-frontend.mjs",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ServerUI",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https://github.com https://*.githubusercontent.com; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; media-src 'self' blob: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "msi", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Desktop control panel for Linux servers",
    "longDescription": "ServerUI is an open-source desktop control panel for managing Linux servers over SSH. The Tauri shell starts a local Go backend; SSH, SFTP, and PTY stay in that backend.",
    "copyright": "Copyright (c) Skyrekon Private Limited",
    "publisher": "Skyrekon Private Limited",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/serverui-server"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ServerUI"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNzM2NjI0MTRGNDg4QkYKUldTL2lQUVVKR1p6d0FOTTdVWUxKZTRDblh1THhrVHVMWElFRENKWU5lYVF2M25ZOWlVOXhwcGYK",
      "endpoints": [
        "https://github.com/rakhechashubham/serverui/releases/latest/download/latest.json"
      ]
    }
  }
}
